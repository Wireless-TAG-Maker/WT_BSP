config WT_BSP_BOARD_HAS_CAMERA
    bool

config WT_BSP_ENABLE_CAMERA
    bool "Enable JPEG camera capture"
    depends on WT_BSP_BOARD_HAS_CAMERA
    default y
    help
        Expose board-owned JPEG frames to an application. Camera hardware
        is prepared explicitly by the application. Recording, USB streaming
        and other consumers coordinate frame use in the application layer.

# Keep a value in sdkconfig.json even when the capability hides the bool.
config WT_BSP_DEP_CAMERA
    string
    default "y" if WT_BSP_ENABLE_CAMERA
    default "n"
