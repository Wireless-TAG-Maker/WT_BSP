config WT_BSP_CAMERA_SENSOR_OV3660
    bool
    depends on WT_BSP_ENABLE_CAMERA
    select CAMERA_OV3660
    select CAMERA_OV3660_DVP_JPEG_640X480_25FPS
    set CAMERA_OV3660_DVP_IF_FORMAT_INDEX_DEFAULT=7
    help
        Build the OV3660 driver and its VGA native JPEG format. The board
        selects wiring, operating parameters and optional image tuning.

if WT_BSP_CAMERA_SENSOR_OV3660

choice CAMERA_OV3660_DVP_DEFAULT_FMT  # ignore: multiple-definition
    default CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_640X480_25FPS
endchoice

endif
