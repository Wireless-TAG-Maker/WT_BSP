config WT_BSP_BOARD_HAS_RGB
    bool

config WT_BSP_ENABLE_RGB
    bool "Enable RGB LED BSP"
    depends on WT_BSP_BOARD_HAS_RGB
    default y

# Keep a value in sdkconfig.json even when the capability hides the bool.
config WT_BSP_DEP_RGB
    string
    default "y" if WT_BSP_ENABLE_RGB
    default "n"
