config WT_BSP_BOARD_HAS_CSI
    bool

config WT_BSP_ENABLE_CSI
    bool "Enable CSI camera BSP"
    depends on WT_BSP_BOARD_HAS_CSI
    default y

# Keep a value in sdkconfig.json even when the capability hides the bool.
config WT_BSP_DEP_CSI
    string
    default "y" if WT_BSP_ENABLE_CSI
    default "n"
