config WT_BSP_SELECTED_BOARD_WT9932C5_TINY  # ignore: multiple-definition
    bool

choice WT_BSP_BOARD  # ignore: multiple-definition
    default WT_BSP_BOARD_WT9932C5_TINY if WT_BSP_SELECTED_BOARD_WT9932C5_TINY
    default WT_BSP_BOARD_WT9932C5_TINY if !WT_BSP_BOARD_SELECTED_BY_TOOL && IDF_TARGET_ESP32C5

    config WT_BSP_BOARD_WT9932C5_TINY
        bool "WT9932C5-TINY"
        depends on IDF_TARGET_ESP32C5
        select WT_BSP_BOARD_HAS_BOARD
        select WT_BSP_BOARD_HAS_BUTTON
        select WT_BSP_BOARD_HAS_RGB
endchoice
