config WT_BSP_SELECTED_BOARD_WT9932S31_TINY  # ignore: multiple-definition
    bool

choice WT_BSP_BOARD  # ignore: multiple-definition
    default WT_BSP_BOARD_WT9932S31_TINY if WT_BSP_SELECTED_BOARD_WT9932S31_TINY
    default WT_BSP_BOARD_WT9932S31_TINY if !WT_BSP_BOARD_SELECTED_BY_TOOL && IDF_TARGET_ESP32S31

    config WT_BSP_BOARD_WT9932S31_TINY
        bool "WT9932S31-TINY"
        depends on IDF_TARGET_ESP32S31
        select WT_BSP_BOARD_HAS_BOARD
        select WT_BSP_BOARD_HAS_BUTTON
        select WT_BSP_BOARD_HAS_RGB
        select WT_BSP_BOARD_HAS_SDMMC
        select WT_BSP_BOARD_HAS_USB_DEVICE_CDC
        select WT_BSP_BOARD_HAS_USB_DEVICE_UVC
        select WT_BSP_BOARD_HAS_CAMERA
endchoice
