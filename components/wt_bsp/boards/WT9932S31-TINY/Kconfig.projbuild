config WT_BSP_BOARD_WT9932S31_TINY
    bool
    depends on IDF_TARGET_ESP32S31
    default y if WT_BSP_SELECTED_BOARD_WT9932S31_TINY
    default y if !WT_BSP_BOARD_SELECTED_BY_TOOL
    select WT_BSP_BOARD_HAS_BOARD
    select WT_BSP_BOARD_HAS_BUTTON
    select WT_BSP_BOARD_HAS_RGB
    select WT_BSP_BOARD_HAS_SDMMC
    select WT_BSP_BOARD_HAS_USB_DEVICE_CDC
    select WT_BSP_BOARD_HAS_CAMERA

config WT_BSP_USB_DEVICE_COMPOSITE
    bool "Share USB UVC and CDC on J1"
    depends on WT_BSP_BOARD_WT9932S31_TINY && WT_BSP_ENABLE_USB_DEVICE_UVC
    default n
    help
        Enumerate one UVC camera and one CDC ACM serial interface using the
        same TinyUSB device stack. Both camera sensors use bulk transport in
        this mode to tolerate concurrent CDC and SD readback traffic.
        Used by the S31 factory recorder example.

if WT_BSP_BOARD_WT9932S31_TINY && WT_BSP_ENABLE_USB_DEVICE_UVC

choice CAMERA_GC2145_DVP_DEFAULT_FMT  # ignore: multiple-definition
    default CAMERA_GC2145_DVP_DEFAULT_FMT_RGB565_BE_1600X1200_13FPS
endchoice

choice CAMERA_OV3660_DVP_DEFAULT_FMT  # ignore: multiple-definition
    default CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_640X480_25FPS
endchoice

    config WT_BSP_S31_CAMERA_SENSOR_DRIVERS
        bool
        default y
        select CAMERA_GC2145
        select CAMERA_GC2145_DVP_RGB565_BE_1600X1200_13FPS
        select CAMERA_OV3660
        select CAMERA_OV3660_DVP_JPEG_640X480_25FPS
        set CAMERA_GC2145_DVP_IF_FORMAT_INDEX_DEFAULT=1
        set CAMERA_OV3660_DVP_IF_FORMAT_INDEX_DEFAULT=7
        help
            Build both supported low-level drivers and formats. The project
            registers only the sensor selected below, avoiding ambiguous
            auto-detection because both sensors use SCCB address 0x3c.
            GC2145 uses the full-resolution register table as a timing base;
            the application selects UYVY before exposing the camera to UVC.

    choice WT_BSP_S31_CAMERA_SENSOR
        prompt "Camera sensor"
        default WT_BSP_S31_CAMERA_SENSOR_GC2145
        help
            Select the camera module fitted to the DVP connector. This also
            selects the matching sensor format, XCLK and USB UVC mode.

        config WT_BSP_S31_CAMERA_SENSOR_GC2145
            bool "GC2145 / CKS-K210-GC3.1 (default)"
            set UVC_CAM1_FRAMERATE=8
            set UVC_CAM1_FRAMESIZE_WIDTH=1600
            set UVC_CAM1_FRAMESIZE_HEIGT=1200
            help
                Use GC2145 DVP UYVY 1600x1200 at a nominal 8 fps with
                a 20 MHz XCLK and an output-clock divider of two, derived
                from the driver's full-resolution mode. Frames are encoded
                by the ESP32-S31 hardware JPEG encoder and sent over USB Bulk.

        config WT_BSP_S31_CAMERA_SENSOR_OV3660
            bool "OV3660 (legacy supported module)"
            set UVC_CAM1_FRAMERATE=25
            set UVC_CAM1_FRAMESIZE_WIDTH=640
            set UVC_CAM1_FRAMESIZE_HEIGT=480
            help
                Keep the verified OV3660 sensor-native JPEG path at 640x480
                and 25 fps with a 20 MHz XCLK.
    endchoice

    config WT_BSP_S31_OV3660_AE_LEVEL
        int "OV3660 automatic-exposure target level"
        default -4
        range -5 5
        depends on WT_BSP_S31_CAMERA_SENSOR_OV3660
        help
            Set the OV3660 sensor's automatic-exposure target after selecting
            the video format. Lower values preserve highlights and produce a
            darker image; higher values brighten shadows. The -4 default is
            tuned for the verified bright, backlit office scene.

    config WT_BSP_S31_OV3660_JPEG_QUALITY
        int "OV3660 native JPEG quality"
        default 34
        range 1 40
        depends on WT_BSP_S31_CAMERA_SENSOR_OV3660
        help
            Set the quality of JPEG frames encoded inside the OV3660 sensor.
            Higher values improve detail and increase frame size. The sensor's
            VGA format table is approximately quality 31; 34 is a conservative
            High-Speed USB setting.

    config WT_BSP_S31_OV3660_SATURATION
        int "OV3660 saturation level"
        default 0
        range -2 2
        depends on WT_BSP_S31_CAMERA_SENSOR_OV3660
        help
            Override the VGA format table's low-saturation (-2) color matrix
            after selecting the format. Zero restores the neutral OV3660 matrix.

    config WT_BSP_S31_OV3660_SHARPNESS
        int "OV3660 sharpness level"
        default 2
        range -3 3
        depends on WT_BSP_S31_CAMERA_SENSOR_OV3660
        help
            Set the OV3660 manual sharpness level after selecting the format.
            The +2 default adds moderate edge definition without using the
            strongest and most artifact-prone +3 setting.

    config WT_BSP_S31_OV3660_DENOISE
        int "OV3660 denoise level"
        default 4
        range 0 8
        depends on WT_BSP_S31_CAMERA_SENSOR_OV3660
        help
            Set the OV3660 spatial denoise level. Zero disables denoise. The
            common sensor table uses the maximum offset associated with level 8;
            level 4 preserves more fine detail while retaining useful denoise.

    config WT_BSP_S31_JPEG_QUALITY
        int "Hardware JPEG fallback quality"
        default 80
        range 1 100
        help
            Quality for the ESP32-S31 hardware JPEG path used by GC2145 and by
            future compatible non-JPEG sensors. This does not affect the
            OV3660 sensor-native JPEG path.

    config WT_BSP_S31_JPEG_ENCODE_TIMEOUT_MS
        int "Hardware JPEG encoding timeout (ms)"
        depends on WT_BSP_S31_CAMERA_SENSOR_GC2145
        default 200
        range 40 1000
        help
            Internal JPEG engine deadline, separate from the V4L2 dequeue
            timeout. Override esp_video 2.3's fixed 40 ms deadline for UXGA
            encoding without changing the managed component. This does not
            affect OV3660 sensor-native JPEG.

    config WT_BSP_S31_DQBUF_TIMEOUT_MS
        int "Camera/JPEG dequeue timeout (ms)"
        default 2000
        range 100 10000

endif
