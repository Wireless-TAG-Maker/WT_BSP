config WT_BSP_SELECTED_BOARD_WT9932C2_TINY  # ignore: multiple-definition
    bool

choice WT_BSP_BOARD  # ignore: multiple-definition
    default WT_BSP_BOARD_WT9932C2_TINY if WT_BSP_SELECTED_BOARD_WT9932C2_TINY
    default WT_BSP_BOARD_WT9932C2_TINY if !WT_BSP_BOARD_SELECTED_BY_TOOL && IDF_TARGET_ESP32C2

    config WT_BSP_BOARD_WT9932C2_TINY
        bool "WT9932C2-TINY"
        depends on IDF_TARGET_ESP32C2
        select WT_BSP_BOARD_HAS_BOARD
        select WT_BSP_BOARD_HAS_BUTTON
        select WT_BSP_BOARD_HAS_RGB
endchoice
