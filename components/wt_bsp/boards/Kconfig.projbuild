config WT_BSP_BOARD_SELECTED_BY_TOOL  # ignore: multiple-definition
    bool

orsource "$WT_BSP_BOARD_KCONFIG"

choice WT_BSP_BOARD  # ignore: multiple-definition
    prompt "Wireless-Tag board"
    help
        Select the board matching the configured ESP-IDF target. Projects
        can set this choice in sdkconfig.defaults without the set-board tool.
endchoice

# Each board contributes its own choice member, defaults and target dependency.
rsource "*/Kconfig.projbuild"

# Additional board settings stay outside the board-selection choice.
orsource "*/Kconfig.options"

config WT_BSP_ENABLE_USB_DEVICE_UVC
    bool "Enable USB Device UVC"
    depends on WT_BSP_BOARD_WT9932P4_TINY || WT_BSP_BOARD_WT9932P4C61_TINY || WT_BSP_BOARD_WT9932S31_TINY
    select WT_BSP_ENABLE_CSI if IDF_TARGET_ESP32P4
    select WT_BSP_ENABLE_RGB if IDF_TARGET_ESP32P4
    default n
    help
        Expose the board camera to a USB host as a High-Speed UVC MJPEG
        camera. Uses CSI on ESP32-P4 and DVP on ESP32-S31. UVC owns the
        USB device stack. Boards with composite USB support may expose CDC
        on the same stack; a second independent USB driver cannot coexist.

# Keep a value in sdkconfig.json even when the capability hides the bool.
config WT_BSP_DEP_USB_DEVICE_UVC
    string
    default "y" if WT_BSP_ENABLE_USB_DEVICE_UVC
    default "n"
