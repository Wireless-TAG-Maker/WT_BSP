orsource "$WT_BSP_BOARD_KCONFIG"

rsource "WT9932C2-TINY/Kconfig.projbuild"
rsource "WT9932C3-TINY/Kconfig.projbuild"
rsource "WT9932C5-TINY/Kconfig.projbuild"
rsource "WT9932C61-TINY/Kconfig.projbuild"
rsource "WT9932P4-TINY/Kconfig.projbuild"
rsource "WT9932P4C61-TINY/Kconfig.projbuild"

config WT_BSP_ENABLE_USB_DEVICE_UVC
    bool "Enable USB Device UVC"
    depends on IDF_TARGET_ESP32P4
    depends on WT_BSP_BOARD_WT9932P4_TINY || WT_BSP_BOARD_WT9932P4C61_TINY
    select WT_BSP_ENABLE_CSI
    select WT_BSP_ENABLE_RGB
    default n
    help
        Expose the board CSI camera to a USB host as a High-Speed UVC
        MJPEG camera. The board must provide the supported ESP32-P4 CSI
        camera and USB Device hardware.
