config WT_BSP_BOARD_SELECTED_BY_TOOL  # ignore: multiple-definition
    bool

orsource "$WT_BSP_BOARD_KCONFIG"

choice WT_BSP_BOARD  # ignore: multiple-definition
    prompt "Wireless-Tag board"
    help
        Select the board matching the configured ESP-IDF target. Projects
        can set this choice in sdkconfig.defaults without the set-board tool.
endchoice

# Each board contributes its own choice member, defaults and target dependency.
rsource "*/Kconfig.projbuild"

# Additional board settings stay outside the board-selection choice.
orsource "*/Kconfig.options"
